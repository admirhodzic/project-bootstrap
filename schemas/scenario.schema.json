{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-bootstrap.dev/schemas/scenario.schema.json",
  "title": "Project Bootstrap behavioral scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "category",
    "prompt",
    "expectedProfile",
    "required",
    "forbidden",
    "maxQuestions",
    "maxArtifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "category": { "enum": ["safety", "workflow", "delegation", "continuity"] },
    "prompt": { "type": "string", "minLength": 1 },
    "expectedProfile": { "enum": ["quick", "standard", "deep", "incident"] },
    "acceptedProfiles": {
      "type": "array",
      "items": { "enum": ["quick", "standard", "deep", "incident"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "forbidden": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "maxQuestions": { "type": "integer", "minimum": 0 },
    "maxArtifacts": { "type": "integer", "minimum": 0 }
  }
}
